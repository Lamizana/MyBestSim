<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Dashboard eSIM — MyBestSim</title>
<meta name="description" content="Statistiques du catalogue eSIM MyBestSim : 5 056 offres, 18 fournisseurs, prix et volumes comparés.">
<style>
  :root {
    --bleu: #007bff;
    --jaune: #ffcc00;
    --rouge: #de1414;
    --texte: #1d2939;
    --muted: #667085;
    --bord: #e4e7ec;
    --gris: #f7f8fa;
    --blanc: #ffffff;
    --font: "Poppins", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: var(--font);
    color: var(--texte);
    background: var(--blanc);
    line-height: 1.55;
  }
  .conteneur { width: min(1100px, 100% - 2rem); margin-inline: auto; }

  .entete { border-bottom: 1px solid var(--bord); background: var(--blanc); }
  .entete__ligne {
    display: flex; flex-wrap: wrap; gap: 0.75rem;
    justify-content: space-between; align-items: center;
    padding: 0.9rem 0;
  }
  .logo { font-weight: 700; font-size: 1.25rem; color: var(--texte); text-decoration: none; }
  .logo span { color: var(--rouge); }
  .entete__contexte { color: var(--muted); font-size: 0.85rem; }

  .hero { padding: 2.5rem 0 1.5rem; border-bottom: 1px solid var(--bord); }
  .sur-titre {
    margin: 0 0 0.4rem; text-transform: uppercase; letter-spacing: 0.08em;
    font-size: 0.78rem; font-weight: 700; color: var(--bleu);
  }
  h1 { margin: 0 0 0.8rem; font-size: clamp(1.6rem, 4vw, 2.4rem); line-height: 1.2; }
  .hero__texte { margin: 0 0 1.2rem; color: var(--muted); max-width: 60ch; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  .chips li {
    background: #fff8db; border: 1px solid #f2d16b; border-radius: 2px;
    padding: 0.2rem 0.6rem; font-size: 0.82rem;
  }

  section { padding: 2rem 0; border-bottom: 1px solid var(--bord); }
  h2 { margin: 0 0 1rem; font-size: 1.25rem; }
  h2 .compte { color: var(--muted); font-weight: 400; font-size: 0.9rem; }

  .grille-kpi {
    display: grid; gap: 0.9rem;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  }
  .carte-kpi {
    border: 1px solid var(--bord); border-top: 3px solid var(--bleu);
    padding: 0.9rem 1rem; background: var(--blanc);
  }
  .carte-kpi:nth-child(3n+2) { border-top-color: var(--jaune); }
  .carte-kpi:nth-child(3n+3) { border-top-color: var(--rouge); }
  .carte-kpi__label { margin: 0; color: var(--muted); font-size: 0.8rem; }
  .carte-kpi__valeur {
    margin: 0.25rem 0 0; font-size: 1.55rem; font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .carte-kpi__detail { margin: 0.2rem 0 0; color: var(--muted); font-size: 0.78rem; }

  .barres { display: grid; gap: 0.35rem; }
  .barre { display: grid; grid-template-columns: 110px 1fr 64px; align-items: center; gap: 0.6rem; }
  .barre__nom { font-size: 0.85rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .barre__piste { background: var(--gris); height: 14px; border-radius: 2px; overflow: hidden; }
  .barre__valeur { display: block; height: 100%; background: var(--bleu); }
  .barre__nombre { text-align: right; font-size: 0.82rem; font-variant-numeric: tabular-nums; }

  .duo { display: grid; gap: 1.5rem; grid-template-columns: 1fr 1fr; }
  .graphique { border: 1px solid var(--bord); padding: 1rem; }
  .graphique h2 { font-size: 1rem; margin-bottom: 0.5rem; }
  .graphique p { margin: 0 0 0.8rem; color: var(--muted); font-size: 0.82rem; }
  .graphique svg { width: 100%; height: auto; display: block; }

  .ecart {
    background: #fffbe6; border: 1px solid #f2d16b; border-left: 4px solid var(--jaune);
    padding: 1.25rem;
  }
  .ecart__chiffre { margin: 0; font-size: clamp(2rem, 6vw, 3rem); font-weight: 700; color: var(--rouge); }
  .ecart__texte { margin: 0.3rem 0 1rem; max-width: 70ch; }
  .ecart__liste { margin: 0; padding-left: 1.1rem; font-size: 0.88rem; }
  .ecart__liste li { margin-bottom: 0.25rem; }

  .selecteur { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; margin-bottom: 0.9rem; }
  .selecteur label { font-size: 0.85rem; color: var(--muted); }
  .selecteur select {
    font: inherit; padding: 0.45rem 0.6rem; border: 1px solid var(--bord);
    background: var(--blanc); color: var(--texte); min-width: 220px;
  }
  .tableau { overflow-x: auto; border: 1px solid var(--bord); }
  table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
  caption { text-align: left; padding: 0.6rem 0.8rem; color: var(--muted); font-size: 0.8rem; }
  th, td { padding: 0.55rem 0.8rem; border-bottom: 1px solid var(--bord); text-align: left; }
  thead th { background: var(--gris); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; }
  tbody tr:nth-child(even) { background: #fcfcfd; }
  .num { text-align: right; font-variant-numeric: tabular-nums; }

  .methodo ul { margin: 0; padding-left: 1.1rem; color: var(--muted); font-size: 0.88rem; }
  .methodo li { margin-bottom: 0.35rem; }

  footer { padding: 1.5rem 0 2.5rem; color: var(--muted); font-size: 0.82rem; }
  footer a { color: var(--bleu); }

  @media (max-width: 820px) {
    .duo { grid-template-columns: 1fr; }
    .barre { grid-template-columns: 88px 1fr 52px; }
  }
</style>
</head>
<body>

<header class="entete">
  <div class="conteneur entete__ligne">
    <a class="logo" href="https://mybestsim.com/fr/">MyBest<span>Sim</span></a>
    <span class="entete__contexte">Dashboard du catalogue eSIM — test de recrutement</span>
  </div>
</header>

<main class="conteneur">

  <section class="hero">
    <p class="sur-titre">Catalogue eSIM</p>
    <h1>{{ meta.lignes | fr }} offres comparées, {{ meta.fournisseurs }} fournisseurs</h1>
    <p class="hero__texte">
      Consolidation de 18 fichiers fournisseurs, nettoyage, contrôle et calcul des
      indicateurs de prix. Tous les chiffres de cette page proviennent du même
      fichier <code>metrics.json</code>.
    </p>
    <ul class="chips">
      <li>{{ meta.lignes | fr }} offres</li>
      <li>{{ meta.fournisseurs }} fournisseurs</li>
      <li>{{ kpi.part_illimite.valeur.nb | fr }} offres illimitées</li>
      <li>Devise : {{ meta.devise }}</li>
    </ul>
  </section>

  <section aria-labelledby="titre-kpi">
    <h2 id="titre-kpi">Les chiffres clés</h2>
    <div class="grille-kpi">
      <article class="carte-kpi">
        <p class="carte-kpi__label">Nombre total de cartes</p>
        <p class="carte-kpi__valeur">{{ kpi.total_cartes.valeur | fr }}</p>
        <p class="carte-kpi__detail">lignes valides après nettoyage</p>
      </article>
      <article class="carte-kpi">
        <p class="carte-kpi__label">Cartes au-delà de 100 €</p>
        <p class="carte-kpi__valeur">{{ kpi.prix_superieur_100.valeur | fr }}</p>
        <p class="carte-kpi__detail">prix strictement supérieur à 100 €</p>
      </article>
      <article class="carte-kpi">
        <p class="carte-kpi__label">Fourchette de prix</p>
        <p class="carte-kpi__valeur">
          {{ kpi.fourchette_prix.valeur.min | fr(2) }} – {{ kpi.fourchette_prix.valeur.max | fr(2) }} €
        </p>
        <p class="carte-kpi__detail">minimum et maximum du catalogue</p>
      </article>
      <article class="carte-kpi">
        <p class="carte-kpi__label">Moyenne de data</p>
        <p class="carte-kpi__valeur">{{ kpi.data_gb_moyenne.valeur | fr(2) }} Go</p>
        <p class="carte-kpi__detail">
          sur {{ (meta.lignes - kpi.part_illimite.valeur.nb) | fr }} offres finies
        </p>
      </article>
      <article class="carte-kpi">
        <p class="carte-kpi__label">Prix moyen</p>
        <p class="carte-kpi__valeur">{{ kpi.prix_moyen.valeur.moyenne | fr(2) }} €</p>
        <p class="carte-kpi__detail">médiane {{ kpi.prix_moyen.valeur.mediane | fr(2) }} €</p>
      </article>
      <article class="carte-kpi">
        <p class="carte-kpi__label">Fournisseurs</p>
        <p class="carte-kpi__valeur">{{ meta.fournisseurs }}</p>
        <p class="carte-kpi__detail">référencés dans le catalogue</p>
      </article>
    </div>
  </section>

  <section aria-labelledby="titre-fournisseurs">
    <h2 id="titre-fournisseurs">
      Répartition par fournisseur
      <span class="compte">— nombre d'offres</span>
    </h2>
    <div class="barres">
      {% for ligne in fournisseurs %}
      <div class="barre">
        <span class="barre__nom">{{ ligne.provider }}</span>
        <span class="barre__piste">
          <span class="barre__valeur" style="width: {{ (ligne.cartes / max_cartes * 100) | round(1) }}%"></span>
        </span>
        <span class="barre__nombre">{{ ligne.cartes | fr }}</span>
      </div>
      {% endfor %}
    </div>
  </section>

  <section class="duo" aria-label="Graphiques de prix">
    <div class="graphique">
      <h2>Distribution des prix</h2>
      <p>Nombre d'offres par tranche de 10 €, sur {{ meta.lignes | fr }} offres.</p>
      {{ histogramme | safe }}
    </div>
    <div class="graphique">
      <h2>Prix au Go par volume</h2>
      <p>Prix médian du Go selon le volume, hors offres illimitées.</p>
      {{ volume | safe }}
    </div>
  </section>

  <section aria-labelledby="titre-ecart">
    <div class="ecart">
      <p class="sur-titre">Le même forfait, pas le même prix</p>
      <p class="ecart__chiffre">{{ kpi.ecart_bundles.valeur.ecart_median_pct | fr(1) }} %</p>
      <p class="ecart__texte">
        Écart médian entre le fournisseur le moins cher et le plus cher pour un
        même forfait (destination, volume, durée). Calculé sur
        {{ kpi.ecart_bundles.valeur.nb_bundles | fr }} forfaits proposés par au
        moins deux fournisseurs ; le plus grand écart atteint
        {{ kpi.ecart_bundles.valeur.ecart_max_pct | fr(1) }} %.
      </p>
      <ul class="ecart__liste">
        {% for exemple in kpi.ecart_bundles.valeur.exemples %}
        <li>
          <strong>{{ exemple.destination }}</strong>, {{ exemple.data_display }}
          {{ exemple.validity_days }} j :
          {{ exemple.prix_min | fr(2) }} € → {{ exemple.prix_max | fr(2) }} €
          (+{{ exemple.ecart_pct | fr(1) }} %)
        </li>
        {% endfor %}
      </ul>
    </div>
  </section>

  <section aria-labelledby="titre-destination">
    <h2 id="titre-destination">Meilleure offre par destination</h2>
    <p class="hero__texte">
      À 15 jours, pour chaque palier de volume, le fournisseur le moins cher.
      Les zones (Europe, Asie, Monde…) sont exclues : on compare des pays.
    </p>
    <div class="selecteur">
      <label for="destination">Destination</label>
      <select id="destination"></select>
    </div>
    <div class="tableau">
      <table id="table-destination">
        <caption>Offres les moins chères à 15 jours, par palier de volume.</caption>
        <thead>
          <tr>
            <th scope="col">Volume</th>
            <th scope="col">Fournisseur</th>
            <th scope="col" class="num">Prix min</th>
            <th scope="col" class="num">Prix max</th>
            <th scope="col" class="num">Écart</th>
            <th scope="col" class="num">Offres</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
  </section>

  <section class="methodo" aria-labelledby="titre-methodo">
    <h2 id="titre-methodo">Méthodologie</h2>
    <ul>
      <li>{{ meta.lignes | fr }} offres lues dans 18 fichiers, aucune ligne rejetée.</li>
      <li>
        Moyenne de data calculée sur les
        {{ (meta.lignes - kpi.part_illimite.valeur.nb) | fr }} offres à volume
        fini ; les {{ kpi.part_illimite.valeur.nb | fr }} offres illimitées sont
        exclues et ne valent jamais 0 Go.
      </li>
      <li>
        Prix au Go et écart par forfait excluent les offres sans volume, sauf
        mention contraire.
      </li>
      <li>
        Destinations : {{ destinations | length }} pays, zones exclues,
        comparaison à 15 jours pour un même palier de volume.
      </li>
      <li>
        Écart par forfait : zones incluses, uniquement les forfaits proposés par
        au moins deux fournisseurs.
      </li>
      <li>
        Jeu de données synthétique fourni pour le test : les relations observées
        décrivent ce catalogue, pas le marché réel.
      </li>
    </ul>
  </section>

</main>

<footer class="conteneur">
  <p>
    Réalisé dans le cadre du test de recrutement MyBestSim —
    <a href="https://github.com/Lamizana/MyBestSim">code source</a>.
  </p>
</footer>

<script id="donnees-destinations" type="application/json">{{ destinations | tojson }}</script>
<script>
(function () {
  const donnees = JSON.parse(document.getElementById("donnees-destinations").textContent);
  const select = document.getElementById("destination");
  const corps = document.querySelector("#table-destination tbody");

  const nombre = (valeur, decimales = 2) =>
    valeur.toLocaleString("fr-FR", {
      minimumFractionDigits: decimales,
      maximumFractionDigits: decimales,
    });

  donnees.forEach((pays) => {
    const option = document.createElement("option");
    option.value = pays.country_code;
    option.textContent = pays.country_name;
    select.appendChild(option);
  });

  function afficher(code) {
    const pays = donnees.find((entree) => entree.country_code === code);
    corps.textContent = "";
    pays.offres.forEach((offre) => {
      const ecart = ((offre.prix_max - offre.price) / offre.price) * 100;
      const ligne = document.createElement("tr");
      const cellules = [
        offre.data_display,
        offre.provider,
        nombre(offre.price) + " €",
        nombre(offre.prix_max) + " €",
        "+" + nombre(ecart, 1) + " %",
        String(offre.nb_offres),
      ];
      cellules.forEach((texte, index) => {
        const cellule = document.createElement("td");
        cellule.textContent = texte;
        if (index >= 2 && index <= 4) {
          cellule.className = "num";
        }
        ligne.appendChild(cellule);
      });
      corps.appendChild(ligne);
    });
  }

  const defaut = donnees.some((pays) => pays.country_code === "ES")
    ? "ES"
    : donnees[0].country_code;
  select.value = defaut;
  afficher(defaut);
  select.addEventListener("change", () => afficher(select.value));
})();
</script>

</body>
</html>
